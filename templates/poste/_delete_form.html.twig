<form method="post" action="{{ path('app_poste_delete', {'id': poste.id}) }}" data-bp-confirm="Supprimer ce poste ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ poste.id) }}">
    <button class="m-btn m-btn--danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
</form>
