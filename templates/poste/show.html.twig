{% extends 'layout.html.twig' %}

{% block title %}{{ poste.libelle }} - Postes de travaux{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane"><a href="{{ path('app_poste_index') }}">Postes de travaux</a><span aria-hidden="true">/</span><span>{{ poste.libelle }}</span></nav>
            <h1>{{ poste.libelle }}</h1>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_poste_index') }}" class="m-btn m-btn--ghost"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour</a>
            <a href="{{ path('app_poste_edit', {'id': poste.id}) }}" class="m-btn m-btn--primary"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Modifier</a>
        </div>
    </div>

    <section class="m-card">
        <dl class="bp-dl">
            <dt>Libellé</dt><dd>{{ poste.libelle ?: '-' }}</dd>
            <dt>TVA</dt><dd>{{ poste.tva ?? '-' }}</dd>
            <dt>Ordre d'affichage</dt><dd>{{ poste.ordre ?? '-' }}</dd>
            <dt>Archivé</dt><dd>{% if poste.archive %}<span class="bp-badge">Archivé</span>{% else %}<span class="bp-badge bp-badge--success">Actif</span>{% endif %}</dd>
        </dl>
    </section>

    <div class="bp-form-actions">
        {{ include('poste/_delete_form.html.twig') }}
    </div>
{% endblock %}
