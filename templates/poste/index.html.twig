{% extends 'layout.html.twig' %}

{% block title %}Postes de travaux{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Postes de travaux</h1>
            <p class="subtitle">Postes utilisés dans les devis et les chantiers.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_poste_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter un poste</a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead><tr><th>Libellé</th><th class="is-num">TVA</th><th class="is-num">Ordre d'affichage</th><th>Archivé</th><th class="is-end">Actions</th></tr></thead>
                <tbody>
                {% for poste in postes %}
                    <tr>
                    <td class="bp-table__ref" data-label="Libellé">{{ poste.libelle }}</td>
                    <td class="is-num" data-label="TVA">{{ poste.tva ?? '-' }}</td>
                    <td class="is-num" data-label="Ordre d'affichage">{{ poste.ordre ?? '-' }}</td>
                    <td data-label="Archivé">{% if poste.archive %}<span class="bp-badge">Archivé</span>{% else %}<span class="bp-badge bp-badge--success">Actif</span>{% endif %}</td>
                    <td class="is-end"><div class="bp-actions"><a class="bp-link" href="{{ path('app_poste_show', {'id': poste.id}) }}">Voir</a><a class="bp-link" href="{{ path('app_poste_edit', {'id': poste.id}) }}">Modifier</a></div></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="bp-table__empty">Aucun poste.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
