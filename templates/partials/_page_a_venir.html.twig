<div class="page-header">
    <div>
        <h1>{{ titre }}</h1>
        <p class="subtitle">{{ sous_titre }}</p>
    </div>
    <div class="page-header__actions" data-edit-only>
        <button type="button" class="m-btn m-btn--primary" disabled title="Pas encore disponible"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{ action }}</button>
    </div>
</div>

<div class="bp-demo-banner">
    <i class="fa-solid fa-person-digging" aria-hidden="true"></i>
    <span>Page en cours de conception - aucune fonctionnalité n'est encore disponible ici.</span>
</div>

<section class="m-card">
    <div class="empty-state">
        <span class="empty-state__icon"><i class="{{ icone }}" aria-hidden="true"></i></span>
        <h2 class="empty-state__title">Page en cours de conception</h2>
        <p class="empty-state__text">Cette page sera bientôt disponible.</p>
    </div>
</section>
