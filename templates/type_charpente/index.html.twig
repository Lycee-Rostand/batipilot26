{% extends 'base.html.twig' %}

{% block title %}TypeCharpente index{% endblock %}

{% block body %}
    <h1>TypeCharpente index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for type_charpente in type_charpentes %}
            <tr>
                <td>{{ type_charpente.id }}</td>
                <td>{{ type_charpente.nom }}</td>
                <td>
                    <a href="{{ path('app_type_charpente_show', {'id': type_charpente.id}) }}">show</a>
                    <a href="{{ path('app_type_charpente_edit', {'id': type_charpente.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_type_charpente_new') }}">Create new</a>
{% endblock %}
