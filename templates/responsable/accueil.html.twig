{% extends 'layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Tableau de bord</h1>
            <p class="subtitle">Accueil du responsable de chantier - tableau de bord de gestion.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('chantier_suivi') }}" class="m-btn m-btn--ghost"><i class="fa-solid fa-helmet-safety" aria-hidden="true"></i> Nouveau chantier</a>
            <a href="{{ path('devis') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Créer un devis</a>
        </div>
    </div>

    <!-- Accès directs demandés : devis, chantiers, indicateurs -->
    <div class="row g-3">
        <div class="col-md-4">
            <a class="bp-quick" href="{{ path('devis') }}">
                <span class="bp-quick__icon"><i class="fa-regular fa-file-lines" aria-hidden="true"></i></span>
                <span><span class="bp-quick__title">Devis</span><span class="bp-quick__text">Créer, suivre et relancer</span></span>
                <i class="fa-solid fa-arrow-right bp-quick__arrow" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-4">
            <a class="bp-quick" href="{{ path('chantiers') }}">
                <span class="bp-quick__icon"><i class="fa-solid fa-helmet-safety" aria-hidden="true"></i></span>
                <span><span class="bp-quick__title">Chantiers</span><span class="bp-quick__text">Suivi des travaux par poste</span></span>
                <i class="fa-solid fa-arrow-right bp-quick__arrow" aria-hidden="true"></i>
            </a>
        </div>
        <div class="col-md-4">
            <a class="bp-quick" href="#indicateurs">
                <span class="bp-quick__icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
                <span><span class="bp-quick__title">Indicateurs (KPI)</span><span class="bp-quick__text">Chiffres clés de l'activité</span></span>
                <i class="fa-solid fa-arrow-right bp-quick__arrow" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <!-- Indicateurs principaux -->
    <div class="bp-block-title" id="indicateurs">
        <h2>Indicateurs <span id="kpi-year"></span></h2>
    </div>
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <div class="bp-kpi">
                <div class="bp-kpi__head"><p class="bp-kpi__label">Chantiers en cours</p><span class="bp-kpi__icon"><i class="fa-solid fa-helmet-safety" aria-hidden="true"></i></span></div>
                <div class="bp-kpi__value" id="kpi-current">-</div>
                <div class="bp-kpi__meta" id="kpi-current-meta">&nbsp;</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bp-kpi">
                <div class="bp-kpi__head"><p class="bp-kpi__label">Chantiers terminés</p><span class="bp-kpi__icon"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span></div>
                <div class="bp-kpi__value" id="kpi-done">-</div>
                <div class="bp-kpi__meta" id="kpi-done-meta">&nbsp;</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bp-kpi">
                <div class="bp-kpi__head"><p class="bp-kpi__label">Total vendu sur l'année</p><span class="bp-kpi__icon"><i class="fa-solid fa-euro-sign" aria-hidden="true"></i></span></div>
                <div class="bp-kpi__value" id="kpi-sold">-</div>
                <div class="bp-kpi__meta">Devis acceptés, HT</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bp-kpi">
                <div class="bp-kpi__head"><p class="bp-kpi__label">Coût de revient global</p><span class="bp-kpi__icon"><i class="fa-solid fa-coins" aria-hidden="true"></i></span></div>
                <div class="bp-kpi__value" id="kpi-cost">-</div>
                <div class="bp-kpi__meta">Fournitures, prestations et main-d'œuvre</div>
            </div>
        </div>
    </div>

    <!-- À traiter -->
    <div class="bp-block-title"><h2>À traiter</h2></div>
    <div class="bp-stat-grid" id="todo-stats"></div>

    <!-- Graphiques -->
    <div class="row g-3 mt-1">
        <div class="col-xl-8">
            <section class="m-card h-100">
                <div class="m-card__header">
                    <div>
                        <h2 class="m-card__title">Ventes et coût de revient par mois</h2>
                        <p class="m-card__subtitle">Montants HT en euros</p>
                    </div>
</div>
                <div class="empty-state">
                    <span class="empty-state__icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
                    <p class="empty-state__text">Aucune donnée de vente pour le moment.</p>
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <section class="m-card h-100">
                <div class="m-card__header">
                    <div>
                        <h2 class="m-card__title">Chantiers par statut</h2>
                        <p class="m-card__subtitle">Module Chantiers</p>
                    </div>
                </div>
                <div class="bp-chart"><canvas id="chart-status" role="img" aria-label="Nombre de chantiers par statut"></canvas></div>
                <div id="chart-status-empty" hidden>
                    <div class="empty-state">
                        <span class="empty-state__icon"><i class="fa-solid fa-helmet-safety" aria-hidden="true"></i></span>
                        <p class="empty-state__text">Aucun chantier pour le moment.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Chantiers en cours + relances -->
    <div class="row g-3 mt-1">
        <div class="col-xl-8">
            <section class="m-card h-100">
                <div class="m-card__header">
                    <div>
                        <h2 class="m-card__title">Chantiers en cours</h2>
                        <p class="m-card__subtitle">Avancement et retards</p>
                    </div>
                    <a class="bp-link" href="{{ path('chantiers') }}">Tout voir →</a>
                </div>
                <div class="bp-table-wrap">
                    <table class="bp-table bp-table--cards">
                        <thead><tr><th>Chantier</th><th>Démarrage</th><th>Fin prévue</th><th>Avancement</th><th>Alerte</th><th class="is-end">Action</th></tr></thead>
                        <tbody id="home-sites"></tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <section class="m-card h-100">
                <div class="m-card__header">
                    <div>
                        <h2 class="m-card__title">Relances devis</h2>
                        <p class="m-card__subtitle">En retard et prochains jours</p>
                    </div>
                    <a class="bp-link" href="{{ path('devis') }}">Devis →</a>
                </div>
<div class="empty-state">
                    <span class="empty-state__icon"><i class="fa-regular fa-bell" aria-hidden="true"></i></span>
                    <p class="empty-state__text">Aucune relance à faire.</p>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('vendor/chartjs/chart.umd.js-4.5.1.min.js') }}"></script>
    <script src="{{ asset('js/batipilot/chantiers-store.js') }}"></script>
    <script src="{{ asset('js/batipilot/devis-store.js') }}"></script>
    <script src="{{ asset('js/batipilot/accueil.js') }}"></script>
{% endblock %}
