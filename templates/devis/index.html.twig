{% extends 'base.html.twig' %}

{% block title %}Devis index{% endblock %}

{% block body %}
    <h1>Devis index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateCreation</th>
                <th>DateValidite</th>
                <th>RefInterne</th>
                <th>DateSignature</th>
                <th>DateRDVClient</th>
                <th>EtatDevis</th>
                <th>TarifStructure</th>
                <th>Ville</th>
                <th>Nom1</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for devi in devis %}
            <tr>
                <td>{{ devi.id }}</td>
                <td>{{ devi.dateCreation ? devi.dateCreation|date('Y-m-d') : '' }}</td>
                <td>{{ devi.dateValidite ? devi.dateValidite|date('Y-m-d') : '' }}</td>
                <td>{{ devi.refInterne }}</td>
                <td>{{ devi.dateSignature ? devi.dateSignature|date('Y-m-d') : '' }}</td>
                <td>{{ devi.dateRDVClient ? devi.dateRDVClient|date('Y-m-d') : '' }}</td>
                <td>{{ devi.etatDevis.id }}</td>
                <td>{{ devi.TarifStructure.id }}</td>
                <td>{{ devi.Maison.ville }}</td>
                <td>{{ devi.Maison.Client.nom }}</td>

                <td>
                    <a href="{{ path('app_devis_show', {'id': devi.id}) }}">show</a>
                    <a href="{{ path('app_devis_edit', {'id': devi.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_devis_new') }}">Create new</a>
{% endblock %}
