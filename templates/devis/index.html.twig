{% extends './layout.html.twig' %}

{% block title %}Devis{% endblock %}

{% block title_page %}Devis{% endblock %}
{% block subtitle_page %}TEST{% endblock %}

{% block page_header %}
    <twig:Cta
        route="app_devis_new"
        message="Démarrer un nouveau devis"
        icon="plus"
    />
    <twig:Cta
        route="app_devis_archives"
        message="Voir les devis archivés"
        secondaire="{{ true }}"
    />
{% endblock %}

{% block body %}
    <div class="bp-toolbar">
        <div class="bp-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" class="form-control" id="devis-search" placeholder="Rechercher : référence, client, ville…" aria-label="Rechercher un devis">
        </div>
    </div>

    <div id="devis-sections">
        <twig:BpSection
            nom="brouillons"
            titre="Brouillons"
            sousTitre="Devis en cours de préparation · version 0"
            :nombre="brouillons|length"
            :colonnes="['Référence', 'Date', 'Nom et prénom du client', 'Ville', 'Dernière version']"
            messageEmpty="Aucun devis"
            :elements="brouillons"
            :proprietesElement="['refInterne', 'dateCreation', 'maison.client.nom', 'maison.ville']"
        />
        <twig:BpSection
            nom="attenteClient"
            titre="En attente client"
            sousTitre="Devis envoyés"
            :nombre="attenteClient|length"
            :colonnes="['Référence', 'Date', 'Nom et prénom du client', 'Ville', 'Dernière version']"
            messageEmpty="Aucun devis"
            :elements="attenteClient"
            :proprietesElement="['refInterne', 'dateCreation', 'maison.client.nom', 'maison.ville']"
            couleur="info"
        />
        <twig:BpSection
            nom="signes"
            titre="Signés"
            sousTitre="Devis acceptés"
            :nombre="signes|length"
            :colonnes="['Référence', 'Date', 'Nom et prénom du client', 'Ville', 'Dernière version']"
            messageEmpty="Aucun devis"
            :elements="signes"
            :proprietesElement="['refInterne', 'dateCreation', 'maison.client.nom', 'maison.ville']"
            couleur="success"
        />
    </div>
{% endblock %}
