{% extends 'layout.html.twig' %}

{% block title %}Prestataires{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Prestataires</h1>
            <p class="subtitle">Liste des prestataires et de leurs postes associés.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_prestataire_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter un prestataire</a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Poste</th>
                        <th>Archivé</th>
                        <th class="is-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for prestataire in prestataires %}
                    <tr>
                        <td class="bp-table__ref" data-label="Nom">{{ prestataire.nom }}</td>
                        <td data-label="Prénom">{{ prestataire.prenom }}</td>
                        <td data-label="Poste">{{ prestataire.poste ? prestataire.poste.libelle : 'Aucun poste' }}</td>
                        <td data-label="Archivé">{{ prestataire.archive == 1 ? 'Oui' : 'Non' }}</td>
                        <td class="is-end">
                            <div class="bp-actions">
                                <a class="bp-link" href="{{ path('app_prestataire_edit', {'id': prestataire.id}) }}">Modifier</a>                   
                                    <form method="post" action="{{ path('app_prestataire_archive', {'id': prestataire.id}) }}" style="display:inline;">
                                        <button type="submit" class="bp-link">Archiver</button>
                                    </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="bp-table__empty">Aucun prestataire.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}