<form method="post" action="{{ path('app_prestataire_delete', {'id': prestataire.id}) }}" data-bp-confirm="Supprimer ce prestataire ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prestataire.id) }}">
    <button class="m-btn m-btn--danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
</form>
