
{% extends 'layout.html.twig' %}

{% block title %}{{ prime.libelle }} - Prime{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane">
                <a href="{{ path('app_prime_index') }}">Primes</a>
                <span aria-hidden="true">/</span>
                <span>{{ prime.libelle }}</span>
            </nav>
            <h1>{{ prime.libelle }}</h1>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_prime_index') }}" class="m-btn m-btn--ghost">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour
            </a>
            <a href="{{ path('app_prime_edit', {'id': prime.id}) }}" class="m-btn m-btn--primary">
                <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Modifier
            </a>
        </div>
    </div>

    <section class="m-card">
        <dl class="bp-dl">
            <dt>Libellé</dt>
            <dd>{{ prime.libelle ?: '-' }}</dd>

            <dt>Organisme</dt>
            <dd>{{ prime.organisme ?: '-' }}</dd>

            <dt>Montant</dt>
            <dd>{{ prime.montant ?? '-' }}</dd>
        </dl>
    </section>

    <div class="bp-form-actions">
        {{ include('prime/_delete_form.html.twig') }}
    </div>
{% endblock %}
