
<form method="post" action="{{ path('app_prime_delete', {'id': prime.id}) }}" data-bp-confirm="Supprimer cette prime ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ prime.id) }}">
    <button class="m-btn m-btn--danger">
        <i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer
    </button>
</form>
