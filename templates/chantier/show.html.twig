{% extends 'layout.html.twig' %}

{% block title %}{{ chantier.reference }} - Chantiers{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane"><a href="{{ path('app_chantier_index') }}">Chantiers</a><span aria-hidden="true">/</span><span>{{ chantier.reference }}</span></nav>
            <h1>{{ chantier.reference }}</h1>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_chantier_index') }}" class="m-btn m-btn--ghost"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour</a>
            <a href="{{ path('app_chantier_edit', {'id': chantier.id}) }}" class="m-btn m-btn--primary"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Modifier</a>
        </div>
    </div>

    <section class="m-card">
        <dl class="bp-dl">
            <dt>Référence</dt><dd>{{ chantier.reference ?: '-' }}</dd>
            <dt>Statut</dt><dd>{{ chantier.statut ? chantier.statut.nom : '-' }}</dd>
            <dt>Date de démarrage</dt><dd>{{ chantier.dateDemarrage ? chantier.dateDemarrage|date('d/m/Y') : '-' }}</dd>
            <dt>Date de fin prévue</dt><dd>{{ chantier.dateFinPrevue ? chantier.dateFinPrevue|date('d/m/Y') : '-' }}</dd>
            <dt>Archivé</dt><dd>{% if chantier.archive %}<span class="bp-badge">Archivé</span>{% else %}<span class="bp-badge bp-badge--success">Actif</span>{% endif %}</dd>
        </dl>
    </section>

    <section class="m-card">
        <div class="page-header">
            <div>
                <h2>Postes du chantier</h2>
            </div>
            <div class="page-header__actions">
                <a href="{{ path('app_chantier_poste_new', {'chantier': chantier.id}) }}" class="m-btn m-btn--primary">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter un poste
                </a>
            </div>
        </div>

        {% if chantier.chantierPostes is empty %}
            <p>Aucun poste rattaché à ce chantier.</p>
        {% else %}
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Poste</th>
                        <th>Montant vendu HT</th>
                        <th>Montant fournitures HT</th>
                        <th>Marge brute HT</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% set totalVendu = 0 %}
                    {% set totalFournitures = 0 %}

                    {% for cp in chantier.chantierPostes %}
                        {% set vendu = cp.montantVenduHT ?? 0 %}
                        {% set fournitures = cp.montantFournituresHT ?? 0 %}
                        {% set marge = vendu - fournitures %}
                        {% set totalVendu = totalVendu + vendu %}
                        {% set totalFournitures = totalFournitures + fournitures %}

                        <tr>
                            <td>{{ cp.poste ? (cp.poste.libelle ?: ('Poste #' ~ cp.poste.id)) : ('Poste #' ~ cp.id) }}</td>
                            <td>{{ vendu|number_format(2, ',', ' ') }} €</td>
                            <td>{{ fournitures|number_format(2, ',', ' ') }} €</td>
                            <td>{{ marge|number_format(2, ',', ' ') }} €</td>
                            <td>
                                <a href="{{ path('app_chantier_poste_edit', {'id': cp.id}) }}" class="m-btn m-btn--ghost">
                                    Modifier
                                </a>
                                <form method="post"
                                      action="{{ path('app_chantier_poste_delete', {'id': cp.id}) }}"
                                      style="display: inline;"
                                      onsubmit="return confirm('Supprimer ce poste du chantier ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cp.id) }}">
                                    <button type="submit" class="m-btn m-btn--danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total</th>
                        <th>{{ totalVendu|number_format(2, ',', ' ') }} €</th>
                        <th>{{ totalFournitures|number_format(2, ',', ' ') }} €</th>
                        <th>{{ (totalVendu - totalFournitures)|number_format(2, ',', ' ') }} €</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        {% endif %}
    </section>

    <div class="bp-form-actions">
        {{ include('chantier/_delete_form.html.twig') }}
    </div>
{% endblock %}