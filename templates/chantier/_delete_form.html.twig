<form method="post" action="{{ path('app_chantier_delete', {'id': chantier.id}) }}" data-bp-confirm="Supprimer ce chantier ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ chantier.id) }}">
    <button class="m-btn m-btn--danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
</form>
