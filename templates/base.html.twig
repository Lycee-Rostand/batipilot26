<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#4272d7">
    <title>{% block title %}Accueil{% endblock %} | BatiPilot</title>
    <link rel="icon" type="image/png" href="{{ asset('images/batipilot/logo-batipilot-icon.png') }}">
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <link rel="stylesheet" href="{{ asset('css/font-face.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/fontawesome-7.3.1/css/all.min.css') }}">
    <link rel="stylesheet" href="{{ asset('vendor/bootstrap-5.3.8.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/theme.css') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
{% set user_name = app.user ? app.user.userIdentifier : app.request.cookies.get('bp_profil', 'Utilisateur') %}
{% set words = user_name|split(' ') %}
{% set initials = (words|length > 1 ? words|map(w => w|first)|join : user_name|slice(0, 2))|upper %}
<body class="app"{% block body_attributes %}{% endblock %}>
    <script>try { if (localStorage.getItem('bp_sidebar') === 'collapsed' && innerWidth >= 992) document.body.classList.add('sidebar-collapsed'); if (sessionStorage.getItem('bp_welcome')) document.body.classList.add('bp-welcome-on'); } catch (e) {}</script>
    <div class="bp-welcome" id="bp-welcome" aria-hidden="true">
        <img class="bp-welcome__logo" src="{{ asset('images/batipilot/logo-batipilot-icon-blanc.png') }}" alt="" width="140" height="140">
    </div>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Aller au contenu</a>
    <div class="page-wrapper">

        <aside class="menu-sidebar" id="main-sidebar">
            <div class="logo">
                <a class="logo-link" aria-label="Accueil BatiPilot">
                    <img class="bp-logo-full" src="{{ asset('images/batipilot/logo-batipilot-blanc.png') }}" alt="BatiPilot" width="131" height="44">
                    <img class="bp-logo-icon" src="{{ asset('images/batipilot/logo-batipilot-icon-blanc.png') }}" alt="" width="36" height="36">
                </a>
                <button class="sidebar-close js-sidebar-toggle" type="button" aria-label="Fermer le menu"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
            <div class="menu-sidebar__content">
                <nav class="navbar-sidebar" aria-label="Menu principal">
                    <ul class="list-unstyled navbar__list">
                        {% block menu %}{% endblock %}
                    </ul>
                </nav>
            </div>
        </aside>
        <script>try { var bpNav = document.querySelector('.menu-sidebar__content'), bpTop = sessionStorage.getItem('bp_sidebar_scroll'); if (bpTop !== null) bpNav.scrollTop = +bpTop; } catch (e) {}</script>

        <div class="page-container">
            <header class="header-desktop">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="header-wrap">
                            <button class="sidebar-toggle js-sidebar-toggle" type="button" aria-label="Afficher ou masquer le menu" aria-expanded="false" aria-controls="main-sidebar"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
                            <div class="bp-topbar-title">{% block space %}{% endblock %}</div>
                            <div class="header-button">
                                <div class="account-wrap">
                                    <div class="account-item clearfix js-item-menu" role="button" tabindex="0" aria-haspopup="true" aria-label="Mon compte">
                                        <div class="image"><span class="bp-avatar" aria-hidden="true">{{ initials }}</span></div>
                                        <div class="content">
                                            <a class="js-acc-btn" href="#">{{ user_name }}</a>
                                            <span class="bp-user-role">{% block user_role %}{% endblock %}</span>
                                        </div>
                                        <div class="account-dropdown js-dropdown">
                                            <div class="info clearfix">
                                                <div class="image"><span class="bp-avatar" aria-hidden="true">{{ initials }}</span></div>
                                                <div class="content">
                                                    <h5 class="name">{{ user_name }}</h5>
                                                    <span class="email">{{ block('user_role') }}</span>
                                                </div>
                                            </div>
                                            <div class="account-dropdown__footer">
                                                <a href="{{ logout_path() }}"><i class="fa-solid fa-power-off"></i>Se déconnecter</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main id="main-content" class="main-content">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        {% block body %}{% endblock %}
                    </div>
                </div>
                {% block footer %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="{{ asset('vendor/bootstrap-5.3.8.bundle.min.js') }}"></script>
    {{ include('partials/_routes_js.html.twig') }}
    <script src="{{ asset('js/batipilot/bp-ui.js') }}"></script>
    <script src="{{ asset('js/batipilot/bp-core.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
