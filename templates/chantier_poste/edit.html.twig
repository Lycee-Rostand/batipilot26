{% extends 'base.html.twig' %}

{% block title %}Modifier le poste - {{ chantier_poste.chantier ? chantier_poste.chantier.reference : 'ChantierPoste' }}{% endblock %}

{% block body %}
    <h1>
        Modifier le poste
        {% if chantier_poste.poste %}
            — {{ chantier_poste.poste.libelle ?: ('Poste #' ~ chantier_poste.poste.id) }}
        {% endif %}
    </h1>

    {{ include('chantier_poste/_form.html.twig', {'button_label': 'Enregistrer'}) }}

    {% if chantier_poste.chantier %}
        <a href="{{ path('app_chantier_show', {'id': chantier_poste.chantier.id}) }}">Retour au chantier</a>
    {% else %}
        <a href="{{ path('app_chantier_index') }}">Retour aux chantiers</a>
    {% endif %}

    {{ include('chantier_poste/_delete_form.html.twig') }}
{% endblock %}