{% extends 'layout.html.twig' %}

{% block title %}Ajouter un poste - {{ chantier is defined and chantier ? chantier.reference : 'Chantier' }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane">
                <a href="{{ path('app_chantier_index') }}">Chantiers</a>
                {% if chantier is defined and chantier %}
                    <span aria-hidden="true">/</span>
                    <a href="{{ path('app_chantier_show', {'id': chantier.id}) }}">{{ chantier.reference }}</a>
                {% endif %}
                <span aria-hidden="true">/</span>
                <span>Ajouter un poste</span>
            </nav>
            <h1>Ajouter un poste</h1>
        </div>
        <div class="page-header__actions">
            {% if chantier is defined and chantier %}
                <a href="{{ path('app_chantier_show', {'id': chantier.id}) }}" class="m-btn m-btn--ghost">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour au chantier
                </a>
            {% else %}
                <a href="{{ path('app_chantier_index') }}" class="m-btn m-btn--ghost">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour
                </a>
            {% endif %}
        </div>
    </div>

    <section class="m-card">
        {{ include('chantier_poste/_form.html.twig', {
            'button_label': 'Enregistrer',
            'cancel_url': (chantier is defined and chantier) ? path('app_chantier_show', {'id': chantier.id}) : path('app_chantier_index')
        }) }}
    </section>
{% endblock %}