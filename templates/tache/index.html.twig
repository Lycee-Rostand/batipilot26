{% extends 'layout.html.twig' %}

{% block title %}Tâches par poste{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Tâches par poste</h1>
            <p class="subtitle">Tâches à réaliser pour chaque poste.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_tache_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter une tâche</a>
        </div>
    </div>

    {% set dernierPoste = null %}
    {% set aDesTaches = false %}

    
                {% for tache in taches %}
                        {% set aDesTaches = true %}
                        {% set posteActuel = tache.posteId.libelle %}
        {% if posteActuel != dernierPoste %}
            {% if dernierPoste is not null %}
                        </tbody>
                    </table>
                </div>
            </section>
            {% endif %}

            <h2 class="bp-section-title" style="margin: 2rem 0 1rem 0; font-size: 1.5rem; font-weight: bold;">
                <i class="fa-solid fa-layer-group" aria-hidden="true"></i> {{ posteActuel }}
            </h2>
            <section class="m-card">
                <div class="bp-table-wrap">
                    <table class="bp-table bp-table--cards">
                        <thead>
                            <tr>
                                <th>Libellé</th>
                                <th>Format de la réponse</th>
                                <th class="is-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
            {% set dernierPoste = posteActuel %}
        {% endif %}

        <tr>
            <td class="bp-table__ref" data-label="Libellé">{{ tache.libelle }}</td>
            <td data-label="Format de la réponse">{{ tache.tacheFormat ? tache.tacheFormat.nom : '-' }}</td>
            <td class="is-end">
                <div class="bp-actions">
                    <a class="bp-link" href="{{ path('app_tache_show', {'id': tache.id}) }}">Voir</a>
                    <a class="bp-link" href="{{ path('app_tache_edit', {'id': tache.id}) }}">Modifier</a>
                </div>
            </td>
        </tr>
         {% if loop.last %}
                    </tbody>
                </table>
            </div>
        </section>
        {% endif %}
    {% endfor %}

    {% if not aDesTaches %}
        <section class="m-card"></section>
            <div class="bp-table-wrap">
                <table class="bp-table">
                    <tbody>
                        <tr><td class="bp-table__empty">Aucune tâche enregistrée.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}

