<form method="post" action="{{ path('app_client_delete', {'id': client.id}) }}" data-bp-confirm="Supprimer ce client ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
    <button class="m-btn m-btn--danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
</form>
