{% extends 'layout.html.twig' %}

{% block title %}{{ client.prenom ~ ' ' ~ client.nom }} - Clients{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane"><a href="{{ path('app_client_index') }}">Clients</a><span aria-hidden="true">/</span><span>{{ client.prenom ~ ' ' ~ client.nom }}</span></nav>
            <h1>{{ client.prenom ~ ' ' ~ client.nom }}</h1>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_client_index') }}" class="m-btn m-btn--ghost"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour</a>
            <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="m-btn m-btn--primary"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Modifier</a>
        </div>
    </div>

    <section class="m-card">
        <dl class="bp-dl">
            <dt>Nom</dt><dd>{{ client.nom ?: '-' }}</dd>
            <dt>Prénom</dt><dd>{{ client.prenom ?: '-' }}</dd>
            <dt>Lieu de naissance</dt><dd>{{ client.lieuNaissance ?: '-' }}</dd>
            <dt>Date de naissance</dt><dd>{{ client.dateNaissance1 ? client.dateNaissance1|date('d/m/Y') : '-' }}</dd>
            <dt>Téléphone</dt><dd>{{ client.telephone1 ?: '-' }}</dd>
            <dt>Mail</dt><dd>{{ client.mail1 ?: '-' }}</dd>
            <dt>Nom (2e client)</dt><dd>{{ client.nom2 ?: '-' }}</dd>
            <dt>Prénom (2e client)</dt><dd>{{ client.prenom2 ?: '-' }}</dd>
        </dl>
    </section>

    <div class="bp-form-actions">
        {{ include('client/_delete_form.html.twig') }}
    </div>
{% endblock %}
