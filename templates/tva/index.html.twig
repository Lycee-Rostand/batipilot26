{% extends 'layout.html.twig' %}

{% block title %}Taux de TVA{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Taux de TVA</h1>
            <p class="subtitle">Taux de TVA et leurs dates de validité.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_tva_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter un taux</a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead><tr><th>Nom</th><th class="is-num">Taux (%)</th><th>Valable à partir du</th><th>Valable jusqu'au</th><th>Archivé</th><th class="is-end">Actions</th></tr></thead>
                <tbody>
                {% for tva in tvas %}
                    <tr>
                    <td class="bp-table__ref" data-label="Nom">{{ tva.nom }}</td>
                    <td class="is-num" data-label="Taux (%)">{{ tva.taux ?? '-' }}</td>
                    <td data-label="Valable à partir du">{{ tva.dataValiditeDebut ? tva.dataValiditeDebut|date('d/m/Y') : '-' }}</td>
                    <td data-label="Valable jusqu'au">{{ tva.dataValiditeFin ? tva.dataValiditeFin|date('d/m/Y') : '-' }}</td>
                    <td data-label="Archivé">{% if tva.archive %}<span class="bp-badge">Archivé</span>{% else %}<span class="bp-badge bp-badge--success">Actif</span>{% endif %}</td>
                    <td class="is-end"><div class="bp-actions"><a class="bp-link" href="{{ path('app_tva_show', {'id': tva.id}) }}">Voir</a><a class="bp-link" href="{{ path('app_tva_edit', {'id': tva.id}) }}">Modifier</a></div></td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="bp-table__empty">Aucun taux de TVA.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
