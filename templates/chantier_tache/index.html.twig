{% extends 'layout.html.twig' %}

{% block title %}Tâches des chantiers{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Tâches des chantiers</h1>
            <p class="subtitle">Valeur saisie pour chaque tâche d'un chantier.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_chantier_tache_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter une tâche</a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead><tr><th>Chantier</th><th>Tâche</th><th>Valeur texte</th><th>Valeur date</th><th class="is-end">Actions</th></tr></thead>
                <tbody>
                {% for chantier_tache in chantier_taches %}
                    <tr>
                    <td class="bp-table__ref" data-label="Chantier">{{ chantier_tache.chantier ? chantier_tache.chantier.reference : '-' }}</td>
                    <td data-label="Tâche">{{ chantier_tache.tache ? chantier_tache.tache.libelle : '-' }}</td>
                    <td data-label="Valeur texte">{{ chantier_tache.valTexte ?: '-' }}</td>
                    <td data-label="Valeur date">{{ chantier_tache.valDate ? chantier_tache.valDate|date('d/m/Y') : '-' }}</td>
                    <td class="is-end"><div class="bp-actions"><a class="bp-link" href="{{ path('app_chantier_tache_show', {'id': chantier_tache.id}) }}">Voir</a><a class="bp-link" href="{{ path('app_chantier_tache_edit', {'id': chantier_tache.id}) }}">Modifier</a></div></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="bp-table__empty">Aucune tâche de chantier.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
