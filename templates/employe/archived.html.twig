{% extends 'layout.html.twig' %}

{% block title %}Employés archivés{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Employés archivés</h1>
            <p class="subtitle">Liste des employés archivés.</p>
        </div>
        <div class="page-header__actions">
            <a class="bp-link bp-link--muted" href="{{ path('app_employe_index') }}">
                ← Retour aux employés actifs
            </a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead>
                    <tr>
                        <th>Employé</th>
                        <th>Coût horaire HT</th>
                        <th>Type de charpente</th>
                        <th class="is-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for employe in employes %}
                    <tr>
                        <td class="bp-table__ref" data-label="Employé">
                            {{ employe.prenom ~ ' ' ~ employe.nom }}
                        </td>
                        <td data-label="Coût horaire HT">
                            {{ employe.coutHrMo|number_format(2, ',', ' ') }} €
                        </td>
                        <td data-label="Type de charpente">
                            {{ employe.TypeCharpente ? employe.TypeCharpente.nom : '-' }}
                        </td>
                        <td class="is-end">
                            <div class="bp-actions">
                                <a class="bp-link" href="{{ path('app_employe_show', {'id': employe.id}) }}">Voir</a>
                                <a class="bp-link" href="{{ path('app_employe_edit', {'id': employe.id}) }}">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="bp-table__empty">
                            Aucun employé archivé.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
