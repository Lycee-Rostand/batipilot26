{% extends 'layout.html.twig' %}

{% block title %}Types de documents{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Types de documents</h1>
            <p class="subtitle">Types de documents rattachés aux devis.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_type_document_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter un type</a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead><tr><th>Nom</th><th>Archivé</th><th class="is-end">Actions</th></tr></thead>
                <tbody>
                {% for type_document in type_documents %}
                    <tr>
                    <td class="bp-table__ref" data-label="Nom">{{ type_document.nom }}</td>
                    <td data-label="Archivé">{% if type_document.archive %}<span class="bp-badge">Archivé</span>{% else %}<span class="bp-badge bp-badge--success">Actif</span>{% endif %}</td>
                    <td class="is-end"><div class="bp-actions"><a class="bp-link" href="{{ path('app_type_document_show', {'id': type_document.id}) }}">Voir</a><a class="bp-link" href="{{ path('app_type_document_edit', {'id': type_document.id}) }}">Modifier</a></div></td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="bp-table__empty">Aucun type de document.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
