{% extends 'layout.html.twig' %}

{% block title %}{{ statut_chantier.nom }} - Statuts des chantiers{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane"><a href="{{ path('app_statut_chantier_index') }}">Statuts des chantiers</a><span aria-hidden="true">/</span><span>{{ statut_chantier.nom }}</span></nav>
            <h1>{{ statut_chantier.nom }}</h1>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_statut_chantier_index') }}" class="m-btn m-btn--ghost"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour</a>
            <a href="{{ path('app_statut_chantier_edit', {'id': statut_chantier.id}) }}" class="m-btn m-btn--primary"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Modifier</a>
        </div>
    </div>

    <section class="m-card">
        <dl class="bp-dl">
            <dt>Nom</dt><dd>{{ statut_chantier.nom ?: '-' }}</dd>
            <dt>Archivé</dt><dd>{% if statut_chantier.archive %}<span class="bp-badge">Archivé</span>{% else %}<span class="bp-badge bp-badge--success">Actif</span>{% endif %}</dd>
        </dl>
    </section>

    <div class="bp-form-actions">
        {{ include('statut_chantier/_delete_form.html.twig') }}
    </div>
{% endblock %}
