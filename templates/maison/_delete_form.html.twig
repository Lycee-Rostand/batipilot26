<form method="post" action="{{ path('app_maison_delete', {'id': maison.id}) }}" data-bp-confirm="Supprimer cette maison ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ maison.id) }}">
    <button class="m-btn m-btn--danger"><i class="fa-regular fa-trash-can" aria-hidden="true"></i> Supprimer</button>
</form>
 