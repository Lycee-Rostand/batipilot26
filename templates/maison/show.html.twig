{% extends 'layout.html.twig' %}

{% block title %}{{ maison.rue ~ ', ' ~ maison.ville }} - Maisons{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <nav class="bp-breadcrumb" aria-label="Fil d'Ariane"><a href="{{ path('app_maison_index') }}">Maisons</a><span aria-hidden="true">/</span><span>{{ maison.rue ~ ', ' ~ maison.ville }}</span></nav>
            <h1>{{ maison.rue ~ ', ' ~ maison.ville }}</h1>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_maison_index') }}" class="m-btn m-btn--ghost"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Retour</a>
            <a href="{{ path('app_maison_edit', {'id': maison.id}) }}" class="m-btn m-btn--primary"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i> Modifier</a>
        </div>
    </div>

    <section class="m-card">
        <dl class="bp-dl">
            <dt>Rue</dt><dd>{{ maison.rue ?: '-' }}</dd>
            <dt>Code postal</dt><dd>{{ maison.copos ?: '-' }}</dd>
            <dt>Ville</dt><dd>{{ maison.ville ?: '-' }}</dd>
            <dt>Client</dt><dd>{{ maison.client ? maison.client.prenom ~ ' ' ~ maison.client.nom : '-' }}</dd>
            <dt>Type de charpente</dt><dd>{{ maison.typeCharpente ? maison.typeCharpente.nom : '-' }}</dd>
            <dt>Année de construction</dt><dd>{{ maison.anneeConstruction ? maison.anneeConstruction|date('d/m/Y') : '-' }}</dd>
            <dt>Section cadastrale</dt><dd>{{ maison.sectionCadastrale ?: '-' }}</dd>
            <dt>Superficie de la section cadastrale (m²)</dt><dd>{{ maison.superficieSectionCadastrale is not null ? maison.superficieSectionCadastrale : '-' }}</dd>
            <dt>Maison Phénix</dt><dd>{{ maison.maisonPhenix is null ? '-' : (maison.maisonPhenix ? 'Oui' : 'Non') }}</dd>
            <dt>Distance au dépôt (km)</dt><dd>{{ maison.distanceDepot is not null ? maison.distanceDepot : '-' }}</dd>
            <dt>Temps de trajet (min)</dt><dd>{{ maison.tempsTrajet is not null ? maison.tempsTrajet : '-' }}</dd>
            <dt>Surface habitable (m²)</dt><dd>{{ maison.surfaceHabitable is not null ? maison.surfaceHabitable : '-' }}</dd>
            <dt>Surface des combles créée (m²)</dt><dd>{{ maison.surfaceComblesCree is not null ? maison.surfaceComblesCree : '-' }}</dd>
            <dt>Remarques</dt><dd>{{ maison.remarques ?: '-' }}</dd>
        </dl>
    </section>

    <div class="bp-form-actions">
        {{ include('maison/_delete_form.html.twig') }}
    </div>
{% endblock %}