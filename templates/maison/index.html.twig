{% extends 'layout.html.twig' %}

{% block title %}Maisons{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Maisons</h1>
            <p class="subtitle">Liste des maisons enregistrées et de leur client.</p>
        </div>
        <div class="page-header__actions">
            <a href="{{ path('app_maison_new') }}" class="m-btn m-btn--primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ajouter une maison</a>
        </div>
    </div>

    <section class="m-card">
        <div class="bp-table-wrap">
            <table class="bp-table bp-table--cards">
                <thead>
                    <tr>
                        <th>Rue</th>
                        <th>CP</th>
                        <th>Ville</th>
                        <th>Client</th>
                        <th>Type de charpente</th>
                        <th class="is-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for maison in maisons %}
                    <tr>
                        <td class="bp-table__ref" data-label="Rue">{{ maison.rue }}</td>
                        <td data-label="CP">{{ maison.copos }}</td>
                        <td data-label="Ville">{{ maison.ville }}</td>
                        <td data-label="Client">{{ maison.client ? maison.client.nom ~ ' ' ~ maison.client.prenom : '-' }}</td>
                        <td data-label="Type de charpente">{{ maison.typeCharpente ? maison.typeCharpente.nom : '-' }}</td>
                        <td class="is-end">
                            <div class="bp-actions">
                                <a class="bp-link" href="{{ path('app_maison_show', {'id': maison.id}) }}">Voir</a>
                                <a class="bp-link" href="{{ path('app_maison_edit', {'id': maison.id}) }}">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="bp-table__empty">Aucune maison enregistrée.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}