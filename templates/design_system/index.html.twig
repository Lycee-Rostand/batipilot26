    <!-- ===================================================================== CRUD -->
    <section class="m-card bp-ds-section" id="ds-crud">
        <h2 class="bp-ds-title">17. CRUD Symfony (make:crud)</h2>
        <p class="bp-help">Modèle complet : <code>templates/poste/</code> (liste, fiche, nouveau, modifier, formulaire, suppression). Pour un nouveau CRUD, copier ces 6 fichiers et changer les noms.</p>
        <dl class="bp-dl">
            <dt>Gabarit</dt><dd><code>{% verbatim %}{% extends 'layout.html.twig' %}{% endverbatim %}</code>, comme toutes les pages.</dd>
            <dt>Menu</dt><dd>Lien vers la route <code>app_…_index</code> : il reste surligné sur les pages _new, _show et _edit.</dd>
            <dt>Liste</dt><dd><code>m-card</code> + <code>bp-table bp-table--cards</code> (section 8). Liste groupée : une <code>bp-section</code> par groupe avec <code>data-bp-toggle</code>.</dd>
            <dt>Fiche</dt><dd><code>m-card</code> + <code>bp-dl</code> (libellé / valeur).</dd>
            <dt>Formulaire</dt><dd>Le thème <code>form/batipilot_theme.html.twig</code> est actif partout : <code>form_row</code> donne directement un <code>bp-field</code> avec astérisque si obligatoire.</dd>
        </dl>
<p class="bp-label mb-1">Formulaire : templates/poste/_form.html.twig (pas de extends)</p>
{% verbatim %}
<pre class="bp-code">{{ form_start(form, {attr: {class: 'bp-form-card', novalidate: 'novalidate'}}) }}
    &lt;div class="bp-form-grid"&gt;
        {{ form_row(form.libelle, {label: 'Libellé'}) }}
        {{ form_row(form.archive, {label: 'Archivé', help: '0 = actif, 1 = archivé'}) }}
        {{ form_row(form.notes, {label: 'Notes', row_attr: {class: 'bp-field--full'}}) }}
    &lt;/div&gt;
    {{ form_rest(form) }}
    &lt;div class="bp-form-actions"&gt;
        &lt;a href="{{ path('app_poste_index') }}" class="m-btn m-btn--ghost"&gt;Annuler&lt;/a&gt;
        &lt;div class="bp-form-actions__right"&gt;&lt;button class="m-btn m-btn--primary"&gt;Enregistrer&lt;/button&gt;&lt;/div&gt;
    &lt;/div&gt;
{{ form_end(form) }}</pre>
{% endverbatim %}
<p class="bp-label mb-1">Suppression : templates/poste/_delete_form.html.twig (pas de extends)</p>
{% verbatim %}
<pre class="bp-code">&lt;form method="post" action="{{ path('app_poste_delete', {'id': poste.id}) }}" data-bp-confirm="Supprimer ce poste ?"&gt;
    &lt;input type="hidden" name="_token" value="{{ csrf_token('delete' ~ poste.id) }}"&gt;
    &lt;button class="m-btn m-btn--danger"&gt;Supprimer&lt;/button&gt;
&lt;/form&gt;</pre>
{% endverbatim %}
